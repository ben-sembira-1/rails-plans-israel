# Firebase web app config (public values, from the Firebase console -> Project settings -> Your apps).
# Without them, `npm run dev` runs the map without sign-in; a production build shows a "not configured" page.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# OAuth web client ID used for the Google sign-in button (Firebase console -> Authentication -> Sign-in method ->
# Google -> Web SDK configuration -> Web client ID). Without it, sign-in falls back to Firebase's popup flow,
# which fails on many mobile browsers.
VITE_GOOGLE_CLIENT_ID=
