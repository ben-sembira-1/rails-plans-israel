# Firebase web app config (public values, from the Firebase console -> Project settings -> Your apps).
# Without them, `npm run dev` runs the map without sign-in; a production build shows a "not configured" page.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
